<Window x:Class="WeChatSendGuard.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置 — 微信发送防误触助手"
        Icon="/Assets/wcsg.ico"
        Width="780" Height="720"
        MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#FF1E1E1E"
        Foreground="#FFE6E6E6"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <SolidColorBrush x:Key="Fg" Color="#FFE6E6E6" />
        <SolidColorBrush x:Key="Muted" Color="#FF9E9E9E" />
        <SolidColorBrush x:Key="InputBg" Color="#FF2D2D30" />
        <SolidColorBrush x:Key="LineBrush" Color="#FF3F3F46" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Margin" Value="0,4,0,4" />
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Margin" Value="0,2,0,2" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource Fg}" />
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="10,8,10,10" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{StaticResource InputBg}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="0,3,0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
            <StackPanel>

                <GroupBox Header="运行">
                    <StackPanel>
                        <CheckBox x:Name="EnabledBox" Content="启用提醒（总开关）" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="窗口轮询(ms)" Width="120" />
                            <TextBox x:Name="WindowPollBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="50~5000，越大越省电" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="识别间隔(ms)" Width="120" />
                            <TextBox x:Name="OcrIntervalBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="500~5000，仅微信前台时执行（单次识别约 600ms）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="去抖次数" Width="120" />
                            <TextBox x:Name="DebounceBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="连续 N 次识别一致才提交，越大越稳但越迟" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="风险名单">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DockPanel Grid.Column="0">
                            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="添加" Click="OnAddEntryClick" />
                                <Button Content="删除" Click="OnRemoveEntryClick" />
                            </StackPanel>
                            <ListBox x:Name="EntryList" Height="180"
                                     DisplayMemberPath="Name"
                                     SelectionChanged="OnEntrySelectionChanged" />
                        </DockPanel>

                        <StackPanel x:Name="EntryEditor" Grid.Column="1" Margin="12,0,0,0">
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Text="会话名" Width="72" />
                                <TextBox x:Name="EntryNameBox" Width="320" />
                            </StackPanel>
                            <TextBlock Text="匹配模式" Margin="0,8,0,2" />
                            <RadioButton x:Name="EntryModeContains" GroupName="EntryMode" Content="包含（推荐）" />
                            <RadioButton x:Name="EntryModeExact" GroupName="EntryMode" Content="完全相等" />
                            <RadioButton x:Name="EntryModeRegex" GroupName="EntryMode" Content="正则表达式" />
                            <RadioButton x:Name="EntryModeInherit" GroupName="EntryMode" Content="继承默认模式" />
                            <StackPanel Style="{StaticResource Row}">
                                <TextBlock Text="备注" Width="72" />
                                <TextBox x:Name="EntryNoteBox" Width="320" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                <GroupBox Header="匹配">
                    <StackPanel>
                        <TextBlock Text="默认匹配模式（名单项选“继承默认”时生效）" Margin="0,0,0,2" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DefaultModeContains" GroupName="DefaultMode" Content="包含" Margin="0,2,16,2" />
                            <RadioButton x:Name="DefaultModeExact" GroupName="DefaultMode" Content="完全相等" Margin="0,2,16,2" />
                            <RadioButton x:Name="DefaultModeRegex" GroupName="DefaultMode" Content="正则表达式" Margin="0,2,16,2" />
                        </StackPanel>
                        <CheckBox x:Name="CaseSensitiveBox" Content="区分大小写" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="提醒方式 · 红框">
                    <StackPanel>
                        <CheckBox x:Name="BorderEnabledBox" Content="启用红框" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="颜色" Width="120" />
                            <TextBox x:Name="BorderColorBox" Width="100" />
                            <TextBlock Style="{StaticResource Hint}" Text="#RRGGBB 或 #AARRGGBB" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="粗细" Width="120" />
                            <TextBox x:Name="BorderThicknessBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="1~40" />
                        </StackPanel>
                        <CheckBox x:Name="BorderShowLabelBox" Content="显示文字标签" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="标签格式" Width="120" />
                            <TextBox x:Name="BorderLabelFormatBox" Width="320" />
                            <TextBlock Style="{StaticResource Hint}" Text="{}{0} 为命中的名单项" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="提醒方式 · GIF 悬浮窗">
                    <StackPanel>
                        <CheckBox x:Name="GifEnabledBox" Content="启用 GIF" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="GIF 文件" Width="120" />
                            <TextBox x:Name="GifFileBox" Width="320" />
                            <Button Content="浏览…" Click="OnBrowseGifClick" />
                            <TextBlock Style="{StaticResource Hint}" Text="相对路径按程序目录解析；留空则用内置循环动画" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="最大尺寸" Width="120" />
                            <TextBox x:Name="GifMaxSizeBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="16~512（96 DPI 基准，按 dpi/96 缩放）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="偏移 X / Y" Width="120" />
                            <TextBox x:Name="GifOffsetXBox" Width="70" />
                            <TextBox x:Name="GifOffsetYBox" Width="70" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="相对微信窗口左上角（96 DPI 基准）" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="高级 · OCR（仅在非标 DPI 识别异常时才需要改）">
                    <StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="基准裁剪区" Width="120" />
                            <TextBox x:Name="RegionXBox" Width="60" />
                            <TextBox x:Name="RegionYBox" Width="60" Margin="8,0,0,0" />
                            <TextBox x:Name="RegionWBox" Width="70" Margin="8,0,0,0" />
                            <TextBox x:Name="RegionHBox" Width="60" Margin="8,0,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="x / y / width / height（96 DPI 逻辑像素）" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="基准放大倍数" Width="120" />
                            <TextBox x:Name="BaseScaleBox" Width="90" />
                            <TextBlock Style="{StaticResource Hint}" Text="1~8，PaddleOCR 建议 2（越大越准但越慢）" />
                        </StackPanel>
                        <CheckBox x:Name="NormalizeBox" Content="按 DPI 归一化（建议保持勾选）" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="落盘目录" Width="120" />
                            <TextBox x:Name="DumpBox" Width="320" />
                            <Button Content="浏览…" Click="OnBrowseDumpClick" />
                            <TextBlock Style="{StaticResource Hint}" Text="留空则不落盘（排障用）" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="恢复默认（OCR）" Click="OnResetOcrClick" />
                            <TextBlock Style="{StaticResource Hint}" Text="调参方法见程序目录下的“高级配置说明.md”" />
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ConfigPathText" Grid.Column="0"
                       Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="保存并应用" Padding="16,5" Click="OnSaveClick" />
                <Button Content="取消" Padding="16,5" Margin="8,0,0,0" Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
